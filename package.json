{
  "name": "myanmar-offline-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "build:release": "cd android && ./gradlew assembleRelease",
    "web:dev": "vite --host 0.0.0.0",
    "web:build": "vite build",
    "cap:sync": "npm run web:build && npx cap sync android",
    "android:cap": "npm run web:build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build": "npm run web:build"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^15.1.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.87.0",
    "react-native-fs": "^2.20.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.16.0",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.8",
    "@react-native-documents/picker": "^12.0.2",
    "@capacitor/core": "^8.2.0",
    "@capacitor/android": "^8.2.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.0.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-native": "^0.72.8",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "@capacitor/cli": "^8.2.0"
  }
}
